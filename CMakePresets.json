{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug con AddressSanitizer y UBSan",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INSLV_SANITIZERS": "ON" }
    },
    {
      "name": "cobertura",
      "displayName": "Debug con cobertura (GCC y gcovr)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "INSLV_COBERTURA": "ON"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "INSLV_AVISOS_COMO_ERRORES": "ON" }
    },
    {
      "name": "ci-gcc",
      "displayName": "CI con GCC",
      "inherits": "ci",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "ci-clang",
      "displayName": "CI con Clang",
      "inherits": "ci",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "tidy",
      "displayName": "clang-tidy sobre el código nuevo",
      "inherits": "ci",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--warnings-as-errors=*"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "cobertura", "configurePreset": "cobertura" },
    { "name": "ci-gcc", "configurePreset": "ci-gcc" },
    { "name": "ci-clang", "configurePreset": "ci-clang" },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "filter": { "exclude": { "label": "lento" } }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "exclude": { "label": "lento" } }
    },
    {
      "name": "lento",
      "displayName": "Los tests lentos (aut, boxA, ring), en Release",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "include": { "label": "lento" } }
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "filter": { "exclude": { "label": "oraculo|lento" } },
      "environment": { "ASAN_OPTIONS": "hard_rss_limit_mb=2048" }
    },
    {
      "name": "cobertura",
      "inherits": "base",
      "configurePreset": "cobertura",
      "filter": { "exclude": { "label": "oraculo|lento" } }
    },
    {
      "name": "ci-gcc",
      "inherits": "base",
      "configurePreset": "ci-gcc",
      "filter": { "exclude": { "label": "lento" } }
    },
    {
      "name": "ci-clang",
      "inherits": "base",
      "configurePreset": "ci-clang",
      "filter": { "exclude": { "label": "lento" } }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "cobertura",
      "steps": [
        { "type": "configure", "name": "cobertura" },
        { "type": "build", "name": "cobertura" },
        { "type": "test", "name": "cobertura" }
      ]
    }
  ]
}
