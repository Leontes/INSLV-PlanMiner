# clang-tidy para el código nuevo (preset tidy). Las sublibrerías heredadas no se revisan hasta
# que se modernicen: sus fuentes, por CMake (HEREDADA); sus cabeceras, porque HeaderFilterRegex
# solo admite las del código nuevo. Al modernizar una, se añade aquí include/inslv/<nombre>/.
# Fuera: performance-enum-size, que pide un tipo base de un byte para cada enum.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-enum-size,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity
HeaderFilterRegex: '(include/inslv/inslv\.hpp|include/inslv/(comun|datos|difuso|formatos|genetico|reglas)/|tests/)'
FormatStyle: file
