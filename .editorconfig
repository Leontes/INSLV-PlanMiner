root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# El código original y los datos de prueba se dejan como están.
[{old,tests/datos}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
max_line_length = unset

# El código heredado, hasta que se modernice cada sublibrería (ver el README).
[{include/inslv,src}/{datos,difuso,genetico,reglas,aprendizaje}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
max_line_length = unset
